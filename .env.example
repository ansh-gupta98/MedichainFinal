# ─────────────────────────────────────────────────────────────────────────────
# MediChain Backend — Environment Variables
# Copy this file to .env and fill in all values before running
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=replace-with-a-strong-random-secret

# Comma-separated list of allowed CORS origins
# In production, replace * with your actual frontend domain
ALLOWED_ORIGINS=["*"]

# ── InsightFace ──────────────────────────────────────────────────────────────
# buffalo_l  = ArcFace R100 (best accuracy, default)
# buffalo_sc = ArcFace R50  (faster, slightly lower accuracy)
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640

# Cosine distance threshold for a valid match (0.0 = strict, 1.0 = loose)
# 0.45 means similarity must be ≥ 0.55 (55%)
# Recommended: 0.45 for medical use (conservative — fewer false positives)
FACE_MATCH_THRESHOLD=0.45

# ── Firebase ─────────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON key
# Download from: Firebase Console → Project Settings → Service Accounts
# On Render: upload as a secret file and set this path
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIRESTORE_PATIENTS_COLLECTION=patients

# ── Cerebras ─────────────────────────────────────────────────────────────────
# Get your key from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=llama3.1-70b
