rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Patients collection ──────────────────────────────────────────────────
    match /patients/{patientId} {

      // Patient can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == patientId;

      // Verified doctors can read any patient document (read-only)
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.verified == true;

      // Medical records sub-collection
      match /medical_records/{recordId} {

        // Patient reads their own records
        allow read: if request.auth != null && request.auth.uid == patientId;

        // Verified doctors can read and write records
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.verified == true;
      }
    }

    // ── Doctors collection ───────────────────────────────────────────────────
    match /doctors/{doctorId} {

      // Doctors can read/write their own doc
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }

    // ── Doctor query audit log ───────────────────────────────────────────────
    match /doctor_queries/{queryId} {
      allow write: if request.auth != null;
      allow read: if false; // Admin only
    }
  }
}
